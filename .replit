modules = ["nodejs-22", "python-3.11", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dev-server"

[[workflows.workflow]]
name = "dev-server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

[deployment]
build = ["sh", "-c", "npm run build"]
run = ["npm", "start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["wget"]

[objectStorage]
defaultBucketID = "replit-objstore-8b26f28f-1b7d-402f-bc93-d2ccd42f6e12"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
