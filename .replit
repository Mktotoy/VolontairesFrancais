modules = ["nodejs-22", "python-3.11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[deployment]
build = ["sh", "-c", "npm run build"]
run = ["npm", "start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 3000

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
